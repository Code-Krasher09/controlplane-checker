# ControlPlane Checker Prototype v1.3 Configuration Template

# Environment & Server
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=controlplane_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/controlplane_db

# Cache & Hot State (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Semantic Verification Cloud Providers
# Note: GEMINI_API_KEY is required for live cloud Gemini Flash Lite adjudication.
# When running in Demo Mode or with local models only, this may remain blank.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Policy & Runtime Invariants
DEFAULT_MAX_REPAIR_ATTEMPTS=2
DEFAULT_REQUEST_COST_BUDGET_USD=0.05
DEFAULT_ADJUDICATION_BUDGET_USD=0.02
